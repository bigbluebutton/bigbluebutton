{
  "name": "bbb-file-upload",
  "homepage": "https://github.com/bigbluebutton/bigbluebutton/tree/develop/bbb-file-upload#readme",
  "version": "0.0.1",
  "description": "Meeting-scoped file upload service for BigBlueButton. Receives multipart image uploads, validates them (size, pixel dimension, magic bytes) and stores them per meeting for nginx to serve.",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "start": "nodemon --watch src --ext ts,json --exec tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "serve": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "eslint src --max-warnings 0",
    "clean": "rimraf dist && rimraf types",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigbluebutton/bigbluebutton/tree/develop/bbb-file-upload"
  },
  "keywords": [
    "bigbluebutton",
    "file-upload",
    "image"
  ],
  "author": "BigBlueButton Inc.",
  "license": "LGPL-3.0",
  "bugs": {
    "url": "https://github.com/bigbluebutton/bigbluebutton/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "image-size": "^2.0.2",
    "js-yaml": "^4.1.1",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.15",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.56.1"
  }
}
