# meeting credentials
BBB_URL=""                          # https://DOMAIN_NAME/bigbluebutton/ (same as logged by 'bbb-conf --secret')
BBB_SECRET=""
CHECKSUM=""                         # (sha1 | sha256 | sha512) Force a specific checksum algorithm. Useful for when the secret length is not a sha algorithm length

TIMEOUT_MULTIPLIER=1                # (number / empty) Apply a multiplier on default timeouts - depending the server strength (not recommended to use greater values than 3)
MEDIA_BRIDGE=                       # ('livekit' (default) | 'bbb-webrtc-sfu') Media bridge for audio/webcam/screenshare tests. Empty means livekit (the 4.0 default)
PLUGIN_STUB_MANIFEST_URL=           # (url / empty) Any plugin manifest the server accepts (e.g. https://DOMAIN_NAME/plugins/X.json); its script is stubbed to test plugin content. Empty skips those tests

# Console monitoring configuration
# CONSOLE=""                        # (color,norefs,nots,label) Configure console output formatting and enable logging
# CONSOLE_MONITOR=false             # (true/false | "") Enable monitoring and collection of console errors and page errors
# CONSOLE_FAIL=false                # (true/false | "") Fail tests immediately when console/page errors are detected
