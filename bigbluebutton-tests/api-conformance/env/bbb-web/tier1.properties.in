# /etc/bigbluebutton/bbb-web.properties on the Tier 1 stack: what bbb-install
# and bbb-conf set on a packaged server, the host and the salt, and the
# suite's sink. Everything else keeps the package's value. A suite profile
# (env/bbb-web/profiles/) is appended below this when one is in force.
bigbluebutton.web.serverURL=https://localhost:8443
securitySalt=@SALT@
# The suite's sink, on this host's loopback: bbb-web fetches from and calls
# back to a private address only for a host listed here.
fetchUrlAllowedLocalHosts=sink.test
