#!/bin/sh
# Starts Hasura as bbb-graphql-server@8085.service does, then applies BBB's
# metadata as the package's install script does. /tmp/hasura-ready marks
# the metadata applied and consistent.
set -eu
set -a
. /etc/default/bbb-graphql-server
set +a
# The port the unit's name gives, and the admin secret config.yaml (the
# CLI's) has before the install script replaces both with random ones.
export HASURA_GRAPHQL_SERVER_PORT=8085 HASURA_GRAPHQL_ADMIN_SECRET=bigbluebutton
# setpriv keeps root's environment.
export HOME=/home/bigbluebutton USER=bigbluebutton
as_bbb() { setpriv --reuid=bigbluebutton --regid=bigbluebutton --init-groups "$@"; }

rm -f /tmp/hasura-ready
as_bbb /usr/bin/hasura-graphql-engine serve &
engine=$!
trap 'kill -TERM "$engine" 2>/dev/null' TERM INT
until curl -fsS -o /dev/null http://127.0.0.1:8085/healthz 2>/dev/null; do
	if ! kill -0 "$engine" 2>/dev/null; then
		wait "$engine" || exit 1
		exit 1
	fi
	sleep 1
done
# As root, as the install script runs it: the CLI makes a migrations
# directory next to the metadata.
cd /usr/share/bbb-graphql-server
HOME=/root hasura metadata apply --skip-update-check
HOME=/root hasura metadata inconsistency status --skip-update-check
touch /tmp/hasura-ready
wait "$engine"
