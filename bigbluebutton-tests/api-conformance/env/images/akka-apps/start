#!/bin/sh
# Starts akka-apps as bbb-apps-akka.service does, as bigbluebutton.
set -eu
# The unit's Environment= lines.
export MALLOC_ARENA_MAX=2 JAVA_TOOL_OPTIONS=-XX:-UseBASE64Intrinsics
# setpriv keeps root's environment.
export HOME=/home/bigbluebutton USER=bigbluebutton
cd /usr/share/bbb-apps-akka
exec setpriv --reuid=bigbluebutton --regid=bigbluebutton --init-groups bin/bbb-apps-akka
