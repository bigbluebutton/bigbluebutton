# Upstream groups of the enabled optional features (BBB_FEATURES=recording); written by the entrypoint.
# The playback service (BBB_FEATURES contains recording), re-resolved like the groups of
# /etc/nginx/conf.d/bbb-upstreams.conf, whose resolver it uses.
upstream playback {
    zone playback 64k;
    server playback:8080 resolve;
}
