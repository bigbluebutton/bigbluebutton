# Fixture environment of the local real-Docker stack test (dind.sh). Every value is a public,
# fake test value; never use this file on a server reachable from the internet. The certificate
# path is the self-signed one: dind.sh scales certbot to 0, so no ACME request is ever made.
BBB_DOMAIN=bbb.example.com
BBB_PUBLIC_IPV4=203.0.113.10
BBB_SHARED_SECRET=fixturebbbsharedsecretnotreal0000000000000000000
LIVEKIT_API_KEY=fixturelivekitapikey
LIVEKIT_API_SECRET=fixturelivekitapisecretnotreal000000000000000000
TURN_SECRET=fixtureturnsecretnotreal000000000000000000000000
POSTGRES_PASSWORD=fixturepostgrespasswordnotreal000000000000000000
HASURA_ADMIN_SECRET=fixturehasuraadminsecretnotreal00000000000000000
POSTGRES_BBB_CORE_PASSWORD=fixturepostgresbbbcorepasswordnotreal00000000000
POSTGRES_HASURA_APP_PASSWORD=fixturepostgreshasuraapppasswordnotreal00000000
POSTGRES_BBB_HASURA_PASSWORD=fixturepostgresbbbhasurapasswordnotreal00000000
POSTGRES_BLOCKNOTE_PASSWORD=fixturepostgresblocknotepasswordnotreal00000000
ACME_EMAIL=admin@example.com
BBB_FEATURES=recording,webhooks
COMPOSE_PROFILES=${BBB_FEATURES}
BBB_IMAGE_REGISTRY=localhost
