# The site bbb-install writes for a server behind haproxy: port 80 serves the ACME challenge and
# redirects to https; haproxy terminates TLS and passes HTTP with the PROXY protocol to 8081.
server_tokens off;

server {
  listen 8080;
  listen [::]:8080;

  location ^~ / {
    return 301 https://$host$request_uri;
  }

  location ^~ /.well-known/acme-challenge/ {
    allow all;
    default_type "text/plain";
    root /var/www/bigbluebutton-default/assets;
  }

  location = /.well-known/acme-challenge/ {
    return 404;
  }
}

# haproxy is on the compose network (subnet in docker-compose.yml)
set_real_ip_from 172.30.82.0/24;
real_ip_header proxy_protocol;
real_ip_recursive on;
server {
  listen 8081 proxy_protocol;

  # nginx does not know its external port/protocol behind haproxy, so use relative redirects.
  absolute_redirect off;

  access_log  /var/log/nginx/bigbluebutton.access.log;

  # This variable is used instead of $scheme by bigbluebutton nginx include
  # files, so $scheme can be overridden in reverse-proxy configurations.
  set $real_scheme "https";

  # BigBlueButton assets and static content.
  location / {
    root   /var/www/bigbluebutton-default/assets;
    index  index.html index.htm;
    expires 1m;
  }

  # Include specific rules for record and playback
  include /etc/bigbluebutton/nginx/*.nginx;
}
