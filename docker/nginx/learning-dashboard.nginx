# Reports written by bbb-web: /var/bigbluebutton/learning-dashboard/<meeting>/<token>/...
location ~ ^/learning-analytics-dashboard/([^/]+)/([^/]+)/learning_dashboard_data\.json$ {
    alias /var/bigbluebutton/learning-dashboard/$1/$2/learning_dashboard_data.json;
    default_type application/json;
}

location /learning-analytics-dashboard/ {
    proxy_pass http://learning-dashboard:80/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
