[Unit]
Description=BigBlueButton shared notes PDF conversion socket

# Used by bbb-shared-notes-server (group bigbluebutton); each connection starts
# one bbb-shared-notes-conversion@.service. Connections over MaxConnections are refused.
[Socket]
ListenStream=/run/bbb-shared-notes-conversion.sock
Accept=yes
MaxConnections=8
SocketUser=root
SocketGroup=bigbluebutton
SocketMode=0660
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
