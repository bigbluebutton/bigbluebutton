[Unit]
Description=BigBlueButton GraphQL Server
Requires=network.target
Wants=postgresql.service
After=postgresql.service
PartOf=bigbluebutton.target
BindsTo=bbb-graphql-server.service

[Service]
Type=simple
User=bigbluebutton
Group=bigbluebutton
WorkingDirectory=/usr/bin
# Only nginx (upstream 127.0.0.1:8085) and bbb-graphql-middleware talk to the
# engine, both over loopback, so do not listen on all interfaces. To bind
# elsewhere, override this in /etc/bigbluebutton/bbb-graphql-server.env, which
# the service unit already loads; the nginx upstream and the Hasura CLI
# endpoint only need to change if the chosen bind excludes loopback.
Environment=HASURA_GRAPHQL_SERVER_HOST=127.0.0.1
EnvironmentFile=/etc/default/bbb-graphql-server
# Optional file (the service should not fail if the file does not exist)
EnvironmentFile=-/etc/bigbluebutton/bbb-graphql-server.env
# Load Hasura password
EnvironmentFile=/etc/default/bbb-graphql-server-admin-pass
# Load the secret of the Prometheus metrics endpoint. Optional: without the
# file the engine still starts and the fail-closed endpoint answers 401.
EnvironmentFile=-/etc/default/bbb-graphql-server-metrics-secret
Environment=HASURA_GRAPHQL_SERVER_PORT=%i
ExecStart=/usr/bin/hasura-graphql-engine serve
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=60
SuccessExitStatus=143
TimeoutStopSec=5
PermissionsStartOnly=true
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target bigbluebutton.target bbb-graphql-server.service
