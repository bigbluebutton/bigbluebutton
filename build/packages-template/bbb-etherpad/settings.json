/*
 * Etherpad settings for BigBlueButton.
 *
 * This file must be valid JSON. But comments are allowed.
 *
 * Based on settings.json.template of Etherpad 3.3; see that file for the
 * documentation of every option and for the "${ENV_VAR:default}" substitution
 * syntax used below.
 */
{
  "title": "Etherpad",
  "favicon": null,

  /*
   * Skin name: a directory under src/static/skins. "bigbluebutton" is
   * https://github.com/alangecker/bbb-etherpad-skin, added at build time.
   */
  "skinName": "bigbluebutton",
  "skinVariants": "super-light-toolbar super-light-editor light-background",

  "ip": "127.0.0.1",
  "port": 9001,

  "showSettingsInAdminPage": true,

  /*
   * Database: Etherpad shares the local redis with the rest of BigBlueButton.
   * bbb-etherpad's before-install drops the pad keys on every upgrade.
   */
  "dbType": "redis",
  "dbSettings": {
    "host": "127.0.0.1",
    "port": 6379
  },

  /*
   * The default text of a pad: a zero-width-space works around empty pads not
   * being created (https://github.com/ether/etherpad-lite/issues/5787).
   */
  "defaultPadText": "​",

  "padOptions": {
    "noColors":         true,
    "showControls":     true,
    "showChat":         false,
    "showLineNumbers":  false,
    "useMonospaceFont": false,
    "userName":         null,
    "userColor":        null,
    "rtl":              false,
    "alwaysShowChat":   false,
    "chatAndUsers":     false,
    "lang":             "en"
  },

  "padShortcutEnabled": {
    "altF9":     true,
    "altC":      false,
    "cmdShift2": true,
    "delete":    true,
    "return":    true,
    "esc":       true,
    "cmdS":      true,
    "tab":       true,
    "cmdZ":      true,
    "cmdY":      true,
    "cmdI":      true,
    "cmdB":      true,
    "cmdU":      true,
    "cmd5":      true,
    "cmdShiftL": true,
    "cmdShiftN": true,
    "cmdShift1": true,
    "cmdShiftC": true,
    "cmdH":      true,
    "ctrlHome":  true,
    "pageUp":    true,
    "pageDown":  true
  },

  "suppressErrorsInPadText": true,

  /*
   * Only group pads reachable through a session created by bbb-pads; pads are
   * created through the HTTP API only.
   */
  "requireSession": true,
  "editOnly": true,

  "minify": true,
  "maxAge": 21600, // 60 * 60 * 6 = 6 hours

  "soffice": "/usr/share/bbb-libreoffice-conversion/etherpad-export.sh",

  "allowUnknownFileEnds": false,

  "requireAuthentication": false,
  "requireAuthorization": false,

  /*
   * nginx terminates TLS and proxies /pad to Etherpad.
   */
  "trustProxy": true,

  /*
   * Etherpad is embedded in an iframe by the BigBlueButton client.
   */
  "cookie": {
    "sameSite": "None"
  },

  "ipLogging": "full",

  "automaticReconnectionTimeout": 0,

  "scrollWhenFocusLineIsOutOfViewport": {
    "percentage": {
      "editionAboveViewport": 0,
      "editionBelowViewport": 0
    },
    "duration": 0,
    "scrollWhenCaretIsInTheLastLineOfViewport": false,
    "percentageToScrollWhenUserPressesArrowUp": 0
  },

  "socketTransportProtocols": ["websocket", "polling"],

  "socketIo": {
    /*
     * Maximum permitted client message size (in bytes). Keep it small: shared
     * notes are capped by the BigBlueButton client anyway, and large values
     * make memory exhaustion by malicious clients easier.
     */
    "maxHttpBufferSize": 10000
  },

  "loadTest": false,

  "dumpOnUncleanExit": false,

  /*
   * HTTP API authentication.
   *
   * bbb-pads authenticates with the OAuth2 client credentials grant against the
   * OpenID Connect provider embedded in Etherpad (the default since Etherpad
   * 2.0). The client secret is APIKEY.txt; bbb-etherpad's after-install exports it
   * as BBB_PADS_CLIENT_SECRET through /usr/share/etherpad-lite/APIKEY.env.
   *
   * Set "authenticationMethod" to "apikey" (and bbb-pads' etherpad.api.auth.method
   * to "apikey") to fall back to the pre-2.0 "?apikey=" scheme.
   */
  "authenticationMethod": "sso",
  "sso": {
    "issuer": "http://127.0.0.1:9001",
    "clients": [
      {
        "client_id": "bbb-pads",
        "client_secret": "${BBB_PADS_CLIENT_SECRET}",
        "grant_types": ["client_credentials"],
        "response_types": []
      }
    ]
  },

  "ep_pad_ttl": {
    "ttl": 86400, // 24 hours
    "timeout": 30,
    "interval": 21600 // 6 hours
  },

  /*
   * Redis publisher plugin configuration (https://github.com/mconf/ep_redis_publisher):
   * pad events are forwarded to bbb-pads on from-etherpad-redis-channel.
   */
  "ep_redis_publisher": {
    "host": "127.0.0.1",
    "port": 6379
  },

  "importExportRateLimiting": {
    // duration of the rate limit window (milliseconds)
    "windowMs": 90000,
    // maximum number of requests per IP to allow during the rate limit window
    "max": 32
  },

  "importMaxFileSize": 52428800, // 50 * 1024 * 1024

  "commitRateLimiting": {
    // duration of the rate limit window (seconds)
    "duration": 1,
    // maximum number of changes per IP to allow during the rate limit window
    "points": 100
  },

  "toolbar": {
    "left": [
      ["bold", "italic", "underline", "strikethrough"],
      ["orderedlist", "unorderedlist", "undo", "redo"],
      ["importexport"]
    ],
    "right": [[]]
  },

  "exposeVersion": false,

  "loglevel": "INFO",

  /* Override any strings found in locale directories */
  "customLocaleStrings": {
    "de": {
      "pad.importExport.import_export": "Export",
      "pad.toolbar.import_export.title": "Export zu verschiedenen Dateiformaten"
    },
    "en-gb": {
      "pad.importExport.import_export": "Export",
      "pad.toolbar.import_export.title": "Export to different file formats"
    },
    "en": {
      "pad.importExport.import_export": "Export",
      "pad.toolbar.import_export.title": "Export to different file formats"
    },
    "es": {
      "pad.importExport.import_export": "Exportar",
      "pad.toolbar.import_export.title": "Exportar a diferentes formatos de archivos"
    },
    "fr": {
      "pad.importExport.import_export": "Exporter",
      "pad.toolbar.import_export.title": "Exporter vers un format de fichier différent"
    },
    "it": {
      "pad.importExport.import_export": "Esportazione",
      "pad.toolbar.import_export.title": "Esporta a diversi formati di file"
    },
    "pt-br": {
      "pad.importExport.import_export": "Exportar",
      "pad.toolbar.import_export.title": "Exportar para diferentes formatos de arquivo"
    },
    "pt": {
      "pad.importExport.import_export": "Exportar",
      "pad.toolbar.import_export.title": "Exportar para diferentes formatos de ficheiro"
    }
  },

  /* Disable Admin UI tests */
  "enableAdminUITests": false
}
