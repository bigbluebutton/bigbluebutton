# Settings of the docker compose setup: docker/compose/install.sh fills them in, or set every
# value by hand (see "Install with Docker Compose", docs/docs/administration/docker-compose.md).

# The server's DNS name, its public IPv4 address and the contact address for Let's Encrypt.
# ACME_EMAIL can stay empty when your own certificate is in ./data/certs.
BBB_DOMAIN=
BBB_PUBLIC_IP=
ACME_EMAIL=

# Image tag: a branch or release tag; v4.1.x-develop-<commit> pins a set of images built together
BBB_IMAGE_TAG=v4.1.x-develop
# Another image for one component: BBB_<IMAGE>_IMAGE, the image name in upper case with "_"
# (all names: "Run another version of one component" in the docs), e.g.
#BBB_WEB_IMAGE=ghcr.io/bigbluebutton/bigbluebutton/bbb-web:pr-12345
#BBB_SHARED_NOTES_SERVER_IMAGE=localhost/bbb-shared-notes-server:dev
#BBB_HTML5_CLIENT_IMAGE=ghcr.io/bigbluebutton/bigbluebutton/bbb-html5-client@sha256:<digest>

# Optional parts, comma-separated: recording, webhooks
COMPOSE_PROFILES=recording

# Secrets: set each one to the output of `openssl rand -hex 32`
BBB_SHARED_SECRET=
BBB_PAGE_TOKEN_SECRET=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TURN_SECRET=
HASURA_ADMIN_SECRET=
POSTGRES_PASSWORD=
POSTGRES_BBB_CORE_PASSWORD=
POSTGRES_BBB_HASURA_PASSWORD=
POSTGRES_HASURA_APP_PASSWORD=
POSTGRES_BLOCKNOTE_PASSWORD=
