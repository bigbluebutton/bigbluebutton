# Copy to .env and set every value (docker/README.md, "Running with docker compose").

# The server's DNS name, its public IPv4 address and the contact address for Let's Encrypt.
# ACME_EMAIL can stay empty when your own certificate is in ./data/certs.
BBB_DOMAIN=
BBB_PUBLIC_IP=
ACME_EMAIL=

# Image tag: a branch or release tag; v4.1.x-develop-<commit> pins a set of images built together
BBB_IMAGE_TAG=v4.1.x-develop

# Optional parts, comma-separated: recording, webhooks
COMPOSE_PROFILES=recording

# Secrets: set each one to the output of `openssl rand -hex 32`
BBB_SHARED_SECRET=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TURN_SECRET=
HASURA_ADMIN_SECRET=
POSTGRES_PASSWORD=
POSTGRES_BBB_CORE_PASSWORD=
POSTGRES_BBB_HASURA_PASSWORD=
POSTGRES_HASURA_APP_PASSWORD=
POSTGRES_BLOCKNOTE_PASSWORD=
