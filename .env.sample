# BigBlueButton container stack: essential settings (Tier 1).
#
# Generated from docker/config-contract.yaml by docker/contract/generate.sh. Do not edit:
# change the contract and run the generator.
#
# `docker compose run --rm setup` writes .env from this file: it generates the secrets,
# detects the public addresses and asks for the rest. To write .env by hand, copy this file
# and fill in every required value. Optional settings (Tier 2) and override files (Tier 3)
# are described in docs/docs/administration/docker-configuration.md.

# Public hostname of the server (fully qualified, no scheme, no port). All public URLs,
# the TLS certificate, the TURN realm and the TURN URIs handed to clients are derived
# from it.
# Required. Asked by setup. Example: bbb.example.com
# Format: ([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?
BBB_DOMAIN=

# Public IPv4 address of the server. Left empty in .env, the setup container detects it
# and writes it. LiveKit announces it as node_ip (its public ICE candidate). coturn does
# not use it: it relays on its bridge address (see coturn_config).
# Required. Detected by setup when empty. Example: 203.0.113.10
# Format: ((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])
BBB_PUBLIC_IPV4=

# Public IPv6 address of the server, optional. Empty means IPv4 only. Used by preflight
# to check the AAAA record.
# Optional. Detected by setup when empty. Example: 2001:db8::10
# Format: ([0-9A-Fa-f]{0,4}:){2,7}[0-9A-Fa-f]{0,4}
BBB_PUBLIC_IPV6=

# API shared secret (securitySalt). Signs API calls, recording callbacks and webhooks.
# Generated by setup; the known upstream placeholder is rejected.
# Required. Secret. Generated by setup.
# Format: [A-Za-z0-9]{32,}
BBB_SHARED_SECRET=

# LiveKit API key (identifier of the key pair). Shared by livekit-server, bbb-webrtc-sfu
# and bbb-webrtc-recorder. Generated by setup; the SFU placeholder LIVEKIT_KEY and
# livekit-sip's devkey are rejected.
# Required. Generated by setup.
# Format: [A-Za-z0-9]{8,64}
LIVEKIT_API_KEY=

# LiveKit API secret belonging to LIVEKIT_API_KEY. At least 32 characters: livekit-server
# only logs an error for shorter secrets, so the entrypoints enforce it.
# Required. Secret. Generated by setup.
# Format: [A-Za-z0-9]{32,}
LIVEKIT_API_SECRET=

# Shared secret for TURN REST credentials. coturn uses it as static-auth-secret, bbb-web
# to hand time-limited TURN credentials to clients. LiveKit gets no TURN configuration.
# Required. Secret. Generated by setup.
# Format: [A-Za-z0-9+/=]{32,}
TURN_SECRET=

# Password of the PostgreSQL superuser. Used by postgres and by the db-init job that
# (re)creates the BBB databases and roles. Application roles have their own passwords
# (POSTGRES_BBB_CORE_PASSWORD, POSTGRES_HASURA_APP_PASSWORD,
# POSTGRES_BBB_HASURA_PASSWORD, POSTGRES_BLOCKNOTE_PASSWORD).
# Required. Secret. Generated by setup.
# Format: [A-Za-z0-9]{32,}
POSTGRES_PASSWORD=

# Hasura admin secret (HASURA_GRAPHQL_ADMIN_SECRET). Only graphql-server and its metadata
# apply step use it.
# Required. Secret. Generated by setup.
# Format: [A-Za-z0-9]{32,}
HASURA_ADMIN_SECRET=

# Password of the PostgreSQL role bbb_core (akka-apps).
# Required. Secret. Generated by setup.
# Format: [A-Za-z0-9]{32,}
POSTGRES_BBB_CORE_PASSWORD=

# Password of the PostgreSQL role hasura_app (Hasura metadata database).
# Required. Secret. Generated by setup.
# Format: [A-Za-z0-9]{32,}
POSTGRES_HASURA_APP_PASSWORD=

# Password of the PostgreSQL role bbb_hasura (BBB data source of Hasura).
# Required. Secret. Generated by setup.
# Format: [A-Za-z0-9]{32,}
POSTGRES_BBB_HASURA_PASSWORD=

# Password of the PostgreSQL role blocknote_app (shared notes).
# Required. Secret. Generated by setup.
# Format: [A-Za-z0-9]{32,}
POSTGRES_BLOCKNOTE_PASSWORD=

# Contact e-mail for the Let's Encrypt account of the TLS certificate. Not needed with
# the external-proxy feature.
# Required. Asked by setup. Example: admin@example.com
# Format: [A-Za-z0-9._%+-]+@([A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?\.)+[A-Za-z]{2,}
ACME_EMAIL=

# Optional features, comma-separated without spaces: recording, greenlight, webhooks,
# monitoring, external-proxy. COMPOSE_PROFILES is derived from it in .env; images read it
# so their configuration matches the running services.
# Optional. Asked by setup. Example: recording
# Format: ((recording|greenlight|webhooks|monitoring|external-proxy)(,(recording|greenlight|webhooks|monitoring|external-proxy))*)?
BBB_FEATURES=recording

# Compose profiles follow the features. Written into .env as a self-reference (with the
# default of BBB_FEATURES for a missing line); do not change it.
COMPOSE_PROFILES=${BBB_FEATURES-recording}
