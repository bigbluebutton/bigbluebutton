[Unit]
Description=BigBlueButton resque worker for recording archives and meeting events
Wants=redis-server.service
After=redis-server.service
PartOf=bigbluebutton.target

[Service]
Type=simple
ExecStart=/usr/bin/bundle exec rake -f Rakefile resque:workers
WorkingDirectory=/usr/local/bigbluebutton/core/scripts
# Archive a meeting as soon as it ends, without waiting for other recordings to finish processing:
# data the archive step copies, such as the Learning Dashboard file, is only kept for a short time.
# Keep COUNT=1. Archive and events jobs for the same meeting must not run at the same time (#12503).
Environment=QUEUE=rap:archive,rap:events
Environment=COUNT=1
# Environment=VVERBOSE=1
User=bigbluebutton
Restart=always
RestartSec=3
Nice=19

[Install]
WantedBy=multi-user.target bigbluebutton.target
